plot_precision_dist <- function(data, sub_label, pid) {
participant_data <- data %>% filter(participant_id == pid)
if (nrow(participant_data) == 0) return(NULL)
circ_sd <- participant_data$std_circ_deg[1]
abs_mean <- participant_data$abs_mean[1]
if (length(circ_sd) == 0 || is.na(circ_sd)) circ_sd <- NA_real_
if (length(abs_mean) == 0 || is.na(abs_mean)) abs_mean <- NA_real_
limits <- precision_limits_for(data)
ggplot(participant_data, aes(x = abs_precision_deg)) +
geom_histogram(breaks = precision_breaks, fill = "steelblue3", color = "white", alpha = 0.8) +
labs(
title = paste(sub_label, "-", pid),
subtitle = sprintf("circSD = %.2f° | Abs Mean = %.2f°", circ_sd, abs_mean),
x = "Absolute precision (deg)",
y = "Trial count"
) +
theme_minimal() +
scale_x_continuous(limits = limits$x, expand = c(0, 0)) +
scale_y_continuous(limits = limits$y, expand = c(0, 0))
}
plot_RT_dist <- function(data, sub_label, pid) {
participant_data <- data %>% filter(participant_id == pid)
if (nrow(participant_data) == 0) return(NULL)
mean_rt <- mean(participant_data$rt_ms, na.rm = TRUE)
median_rt <- median(participant_data$rt_ms, na.rm = TRUE)
limits <- rt_limits_for(data)
ggplot(participant_data, aes(x = rt_ms)) +
geom_histogram(breaks = rt_breaks, fill = "tomato2", color = "white", alpha = 0.8) +
geom_vline(xintercept = mean_rt, linetype = "dashed", color = "navy") +
geom_vline(xintercept = median_rt, linetype = "dotted", color = "darkgreen") +
labs(
title = paste(sub_label, "-", pid),
subtitle = sprintf("RT distribution (mean %.0f ms / median %.0f ms)",
ifelse(is.na(mean_rt), NA_real_, mean_rt),
ifelse(is.na(median_rt), NA_real_, median_rt)),
x = "Response time (ms)",
y = "Trial count"
) +
theme_minimal() +
scale_x_continuous(limits = limits$x, expand = c(0, 0)) +
scale_y_continuous(limits = limits$y, expand = c(0, 0))
}
render_participant_logits <- function(plot_fn, data, sub_label) {
participants <- sort(unique(data$participant_id))
purrr::walk(participants, function(pid) {
plot_obj <- plot_fn(data, sub_label, pid)
if (!is.null(plot_obj)) print(plot_obj)
})
}
# Walks all participants: abs precision (0–180°) then RT. `axial` is unused here but
# kept so call sites match sub3 vs sub1/2; group-level plots use `axial` separately.
walk_participant_histograms <- function(data, sub_label, axial = FALSE) {
render_participant_logits(plot_precision_dist, data, sub_label)
render_participant_logits(plot_RT_dist, data, sub_label)
}
# Per participant trial-level mixture model fitting:
# per duration, alpha * Uniform + (1 - alpha) * von Mises(mu = 0, kappa fixed).
# Uses sub*prepared (post trial-level filtering).
# Only fit set-size 6 (num_items == 6)
# Only fit duration_ms 50 150 250 as they are present across 3 subs
# cue_type pooled.
# sub1/2: signed error wrapped to (-pi, pi]. sub3: double-angle wrap for axial (see prepare chunk).
mixture_duration_ms <- c(50L, 150L, 250L)
mixture_kappa_fixed <- 1
mixture_set_size <- 6L
mixture_n_starts <- 40L
von_mises_pdf <- function(x, mu, kappa) {
exp(kappa * cos(x - mu)) / (2 * pi * besselI(kappa, nu = 0))
}
circ_error_rad_for_mixture <- function(precision_deg, subset_key) {
phi <- precision_deg * (pi / 180)
if (subset_key %in% c("sub1", "sub2")) {
atan2(sin(phi), cos(phi))
} else if (subset_key == "sub3") {
atan2(sin(2 * phi), cos(2 * phi))
} else {
stop("subset_key must be sub1, sub2, or sub3")
}
}
negloglik_mixture_strata <- function(alpha_vec, angle_lists, kappa, mu = 0) {
if (length(alpha_vec) != length(angle_lists)) stop("alpha_vec length mismatch")
if (any(alpha_vec < 0 | alpha_vec > 1)) return(Inf)
u_dens <- 1 / (2 * pi)
total_ll <- 0
for (j in seq_along(angle_lists)) {
ang <- angle_lists[[j]]
if (length(ang) == 0) next
a <- alpha_vec[j]
vm_d <- von_mises_pdf(ang, mu, kappa)
mix <- a * u_dens + (1 - a) * vm_d
mix <- pmax(mix, 1e-300)
total_ll <- total_ll + sum(log(mix))
}
-total_ll
}
fit_mixture_one_participant <- function(d_sub, pid, subset_key,
kappa = mixture_kappa_fixed,
duration_levels = mixture_duration_ms,
set_size = mixture_set_size,
n_starts = mixture_n_starts) {
d <- d_sub %>%
dplyr::filter(
.data$participant_id == pid,
.data$num_items == set_size,
.data$duration_ms %in% duration_levels
)
if (nrow(d) == 0) {
return(NULL)
}
d$x_circ <- circ_error_rad_for_mixture(d$precision_deg, subset_key)
active_idx <- which(vapply(duration_levels, function(dd) sum(d$duration_ms == dd) > 0L, logical(1)))
if (length(active_idx) == 0) {
return(NULL)
}
active_durs <- duration_levels[active_idx]
angle_lists <- lapply(active_durs, function(dd) d$x_circ[d$duration_ms == dd])
n_par <- length(angle_lists)
best <- list(value = Inf, par = rep(NA_real_, n_par), convergence = NA_integer_)
for (s in seq_len(n_starts)) {
init <- stats::runif(n_par, min = 0.05, max = 0.95)
o <- tryCatch(
stats::optim(
init,
negloglik_mixture_strata,
method = "L-BFGS-B",
lower = rep(0, n_par),
upper = rep(1, n_par),
angle_lists = angle_lists,
kappa = kappa,
mu = 0
),
error = function(e) NULL
)
if (!is.null(o) && is.finite(o$value) && o$value < best$value) {
best$value <- o$value
best$par <- o$par
best$convergence <- as.integer(o$convergence)
}
}
alpha_full <- rep(NA_real_, length(duration_levels))
names(alpha_full) <- as.character(duration_levels)
n_trials <- rep(0L, length(duration_levels))
names(n_trials) <- as.character(duration_levels)
for (j in seq_along(active_durs)) {
dd <- active_durs[j]
alpha_full[as.character(dd)] <- best$par[j]
n_trials[as.character(dd)] <- sum(d$duration_ms == dd)
}
tibble::tibble(
participant_id = pid,
alpha_ms50 = alpha_full[["50"]],
alpha_ms150 = alpha_full[["150"]],
alpha_ms250 = alpha_full[["250"]],
n_trials_50 = n_trials[["50"]],
n_trials_150 = n_trials[["150"]],
n_trials_250 = n_trials[["250"]],
kappa_fixed = kappa,
neg_loglik = best$value,
optim_convergence = best$convergence,
n_alpha_params = n_par,
subset = subset_key
)
}
mixture_fit_report <- function(prepared_df, subset_key) {
pids <- sort(unique(prepared_df$participant_id))
out <- purrr::map(pids, function(pid) {
fit_mixture_one_participant(prepared_df, pid, subset_key)
})
dplyr::bind_rows(purrr::compact(out))
}
set.seed(42)
mixture_fit_sub1 <- mixture_fit_report(sub1prepared, "sub1")
mixture_fit_sub2 <- mixture_fit_report(sub2prepared, "sub2")
mixture_fit_sub3 <- mixture_fit_report(sub3prepared, "sub3")
cat(
"Mixture fit (set size", mixture_set_size, ", durations 50/150/250 ms, kappa =",
mixture_kappa_fixed, "): sub1 rows =", nrow(mixture_fit_sub1),
"| sub2 =", nrow(mixture_fit_sub2),
"| sub3 =", nrow(mixture_fit_sub3), "\n"
)
exclusion_map <- list(
#sub1 = c("08", "18", "24", "25", "29", "30"),
sub1 = c("08", "14", "18", "21", "24", "25", "29","30","32"),
#sub2 = c("01", "10", "12", "22", "29", "30", "31"),
sub2 = c("01", "09", "10","12","15","17","18","22","23","24","26","27","28","29","30","31"),
#sub3 = c("14", "20", "21", "28", "31")
sub3 = c("01","14","20","21","23","24","25","26","27","28","29","30","31")
)
sub1_analysis <- sub1prepared %>% filter(!participant_id %in% exclusion_map$sub1)
sub2_analysis <- sub2prepared %>% filter(!participant_id %in% exclusion_map$sub2)
sub3_analysis <- sub3prepared %>% filter(!participant_id %in% exclusion_map$sub3)
attr(sub1_analysis, "subset_key") <- "sub1"
attr(sub2_analysis, "subset_key") <- "sub2"
attr(sub3_analysis, "subset_key") <- "sub3"
cat("Applied preliminary exclusions; new counts:",
"sub1_analysis =", nrow(sub1_analysis),
"sub2_analysis =", nrow(sub2_analysis),
"sub3_analysis =", nrow(sub3_analysis), "\n")
pd <- position_dodge(width = 0.6)
pj <- position_jitterdodge(dodge.width = 0.6, jitter.width = 0.15, seed = 42)
# Consistent across subexperiments: R / NR match sub1; Baseline distinct (sub2, sub3)
cue_type_colors <- c(
"R-cue" = "#E884A6",
"NR-cue" = "#3D9B9B",
"Baseline" = "#4CAF50"
)
add_cue_type_scales <- function(plot) {
plot +
ggplot2::scale_fill_manual(values = cue_type_colors) +
ggplot2::scale_color_manual(values = cue_type_colors)
}
summarise_cirsd_by_condition <- function(data, include_set_size = FALSE, axial = FALSE) {
group_vars <- c("duration_ms", "cue_type")
if (include_set_size) group_vars <- c(group_vars, "num_items")
# group_modify: explicit per-group theta vectors (avoids summarise + .data[[col]] quirks)
data %>%
dplyr::mutate(theta_axial_rad = 2 * theta_rad) %>%
dplyr::group_by(dplyr::across(dplyr::all_of(group_vars))) %>%
dplyr::group_modify(~ {
theta_vec <- if (axial) .x$theta_axial_rad else .x$theta_rad
circ <- circ_stats_safe(theta_vec, axial = FALSE)
if (axial) {
circ <- circ %>%
dplyr::mutate(
std_circ = std_circ / 2,
std_circ_deg = std_circ_deg / 2
)
}
circ
}) %>%
dplyr::ungroup()
}
plot_group_precision <- function(data, label, include_set_size = FALSE, axial = FALSE) {
summary <- summarise_cirsd_by_condition(
data,
include_set_size = include_set_size,
axial = axial
)
plot <- ggplot(data, aes(x = factor(duration_ms), y = abs_precision_deg, fill = cue_type, color = cue_type)) +
geom_boxplot(alpha = 0.5, position = pd, outlier.shape = NA) +
#geom_jitter(position = pj, alpha = 0.35, size = 0.9) +
geom_point(
data = summary,
inherit.aes = FALSE,
aes(x = factor(duration_ms), y = std_circ_deg, fill = "gray", color = cue_type, group = cue_type),
shape = 23,
size = 2.5,
stroke = 1.1,
position = pd
) +
labs(title = paste(label, "precision (abs error)"),
subtitle = if (axial) "Axial CirSD (deg) per condition" else "CirSD (deg) per condition",
x = "Encoding duration (ms)", y = "Absolute precision (deg)") +
scale_x_discrete(labels = function(x) paste0(x, " ms")) +
theme_minimal() +
theme(legend.position = "top")
plot <- add_cue_type_scales(plot)
if (include_set_size) {
plot <- plot + facet_wrap(~ num_items, labeller = ggplot2::label_both)
}
plot
}
plot_group_rt <- function(data, label, include_set_size = FALSE) {
plot <- ggplot(data, aes(x = factor(duration_ms), y = rt_ms, fill = cue_type, color = cue_type)) +
geom_boxplot(alpha = 0.5, position = pd, outlier.shape = NA) +
geom_jitter(position = pj, alpha = 0.4, size = 1) +
labs(title = paste(label, "RT distribution"),
subtitle = "Conditioned RT spread with quartiles from boxplots",
x = "Encoding duration (ms)", y = "Response time (ms)") +
scale_x_discrete(labels = function(x) paste0(x, " ms")) +
theme_minimal() +
theme(legend.position = "top")
plot <- add_cue_type_scales(plot)
if (include_set_size) {
plot <- plot + facet_wrap(~ num_items, labeller = ggplot2::label_both)
}
plot
}
# Per-participant circular SD within each condition (same theta / axial rules as summarise_cirsd_by_condition)
participant_circsd_by_condition <- function(data, include_set_size = FALSE, axial = FALSE) {
group_vars <- c("participant_id", "duration_ms", "cue_type")
if (include_set_size) group_vars <- c(group_vars, "num_items")
data %>%
dplyr::mutate(theta_axial_rad = 2 * theta_rad) %>%
dplyr::group_by(dplyr::across(dplyr::all_of(group_vars))) %>%
dplyr::group_modify(~ {
theta_vec <- if (axial) .x$theta_axial_rad else .x$theta_rad
circ <- circ_stats_safe(theta_vec, axial = FALSE)
deg <- circ$std_circ_deg[[1]]
if (axial) deg <- deg / 2
tibble::tibble(std_circ_deg = deg, n_trials = nrow(.x))
}) %>%
dplyr::ungroup()
}
# Mean and 95% CI of participant-level CirSDs (one-sample t interval on participants)
summarise_participant_circsd_ci <- function(part_df, include_set_size = FALSE) {
group_vars <- c("duration_ms", "cue_type")
if (include_set_size) group_vars <- c(group_vars, "num_items")
part_df %>%
dplyr::group_by(dplyr::across(dplyr::all_of(group_vars))) %>%
dplyr::reframe({
x <- std_circ_deg[is.finite(std_circ_deg)]
n <- length(x)
if (n == 0L) {
tibble::tibble(
n_participants = 0L,
mean_circsd = NA_real_,
ci_low = NA_real_,
ci_high = NA_real_
)
} else if (n == 1L) {
tibble::tibble(
n_participants = 1L,
mean_circsd = x[1],
ci_low = x[1],
ci_high = x[1]
)
} else {
tt <- stats::t.test(x)
tibble::tibble(
n_participants = n,
mean_circsd = mean(x),
ci_low = tt$conf.int[1],
ci_high = tt$conf.int[2]
)
}
}) %>%
dplyr::ungroup()
}
pj_circsd <- position_jitterdodge(dodge.width = 0.6, jitter.width = 0.15, seed = 42)
plot_group_precision_participant_circsd <- function(data, label, include_set_size = FALSE, axial = FALSE) {
pdat <- participant_circsd_by_condition(data, include_set_size, axial)
sdat <- summarise_participant_circsd_ci(pdat, include_set_size)
plot <- ggplot2::ggplot() +
ggplot2::geom_point(
data = pdat,
ggplot2::aes(
x = factor(duration_ms),
y = std_circ_deg,
color = cue_type
),
position = pj_circsd,
alpha = 0.4,
size = 1.1
) +
ggplot2::geom_pointrange(
data = sdat,
ggplot2::aes(
x = factor(duration_ms),
y = mean_circsd,
ymin = ci_low,
ymax = ci_high,
color = cue_type
),
position = pd,
size = 0.25,
linewidth = 0.9,
fatten = 3
) +
ggplot2::labs(
title = paste(label, "precision — participant CirSD"),
subtitle = if (axial) {
"Per-participant axial CirSD (jitter); mean and 95% CI across participants"
} else {
"Per-participant CirSD (jitter); mean and 95% CI across participants"
},
x = "Encoding duration (ms)",
y = "Circular SD (deg)"
) +
ggplot2::scale_x_discrete(labels = function(x) paste0(x, " ms")) +
ggplot2::theme_minimal() +
ggplot2::theme(legend.position = "top")
plot <- add_cue_type_scales(plot)
if (include_set_size) {
plot <- plot + ggplot2::facet_wrap(~ num_items, labeller = ggplot2::label_both)
}
plot
}
plot_participant_condition_precision <- function(data, label, pid, include_set_size = FALSE, axial = FALSE) {
d <- data %>% filter(participant_id == pid)
if (nrow(d) == 0) return(NULL)
plot_group_precision(d, paste0(label, " — ", pid), include_set_size = include_set_size, axial = axial)
}
plot_participant_condition_rt <- function(data, label, pid, include_set_size = FALSE) {
d <- data %>% filter(participant_id == pid)
if (nrow(d) == 0) return(NULL)
plot_group_rt(d, paste0(label, " — ", pid), include_set_size = include_set_size)
}
walk_participant_condition_plots <- function(data, label, include_set_size, axial) {
pids <- sort(unique(data$participant_id))
purrr::walk(pids, function(pid) {
p_prec <- plot_participant_condition_precision(data, label, pid, include_set_size, axial)
if (!is.null(p_prec)) print(p_prec)
p_rt <- plot_participant_condition_rt(data, label, pid, include_set_size)
if (!is.null(p_rt)) print(p_rt)
})
}
print(plot_group_precision_participant_circsd(sub1_analysis, "Practice Effect", include_set_size = FALSE, axial = FALSE))
print(plot_group_rt(sub1_analysis, "Practice Effect", include_set_size = FALSE))
