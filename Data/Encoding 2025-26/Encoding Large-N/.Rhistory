)
}
d$x_circ <- circ_error_rad_for_mixture(d$precision_deg, subset_key)
active_idx <- which(vapply(duration_levels, function(dd) sum(d$duration_ms == dd) > 0L, logical(1)))
if (length(active_idx) == 0) {
return(
tibble::tibble(
participant_id = pid,
alpha_ms50 = NA_real_,
alpha_ms150 = NA_real_,
alpha_ms250 = NA_real_,
kappa_fixed = kappa,
neg_loglik = NA_real_,
optim_convergence = NA_integer_,
n_alpha_params = 0L,
fit_status = "no_active_duration",
subset = subset_key
)
)
}
active_durs <- duration_levels[active_idx]
angle_lists <- lapply(active_durs, function(dd) d$x_circ[d$duration_ms == dd])
n_par <- length(angle_lists)
best <- list(value = Inf, par = rep(NA_real_, n_par), convergence = NA_integer_)
for (s in seq_len(n_starts)) {
init <- stats::runif(n_par, min = 0.05, max = 0.95)
o <- tryCatch(
stats::optim(
init,
negloglik_mixture_strata,
method = "L-BFGS-B",
lower = rep(0, n_par),
upper = rep(1, n_par),
angle_lists = angle_lists,
kappa = kappa,
mu = 0
),
error = function(e) NULL
)
if (!is.null(o) && is.finite(o$value) && o$value < best$value) {
best$value <- o$value
best$par <- o$par
best$convergence <- as.integer(o$convergence)
}
}
if (!is.finite(best$value)) {
return(
tibble::tibble(
participant_id = pid,
alpha_ms50 = NA_real_,
alpha_ms150 = NA_real_,
alpha_ms250 = NA_real_,
kappa_fixed = kappa,
neg_loglik = NA_real_,
optim_convergence = NA_integer_,
n_alpha_params = n_par,
fit_status = "optim_failed",
subset = subset_key
)
)
}
alpha_full <- rep(NA_real_, length(duration_levels))
names(alpha_full) <- as.character(duration_levels)
for (j in seq_along(active_durs)) {
dd <- active_durs[j]
alpha_full[as.character(dd)] <- best$par[j]
}
tibble::tibble(
participant_id = pid,
alpha_ms50 = alpha_full[["50"]],
alpha_ms150 = alpha_full[["150"]],
alpha_ms250 = alpha_full[["250"]],
kappa_fixed = kappa,
neg_loglik = best$value,
optim_convergence = best$convergence,
n_alpha_params = n_par,
fit_status = ifelse(best$convergence == 0L, "ok", "optim_nonconvergence"),
subset = subset_key
)
}
participant_fit_counts <- function(prepared_df, subset_key,
duration_levels = mixture_duration_ms,
set_size = mixture_set_size) {
participants <- prepared_df %>%
dplyr::distinct(
participant_id,
participant_code,
participant_source,
participant_cohort
) %>%
dplyr::mutate(subset = subset_key)
counts <- prepared_df %>%
dplyr::filter(
.data$num_items == set_size,
.data$duration_ms %in% duration_levels
) %>%
dplyr::count(participant_id, duration_ms, name = "n_trials") %>%
tidyr::pivot_wider(
names_from = duration_ms,
values_from = n_trials,
names_prefix = "n_trials_",
values_fill = 0
)
participants %>%
dplyr::left_join(counts, by = "participant_id") %>%
dplyr::mutate(
n_trials_50 = dplyr::coalesce(.data$n_trials_50, 0L),
n_trials_150 = dplyr::coalesce(.data$n_trials_150, 0L),
n_trials_250 = dplyr::coalesce(.data$n_trials_250, 0L),
n_trials_fit = n_trials_50 + n_trials_150 + n_trials_250,
n_duration_cells_below_min =
(n_trials_50 < mixture_min_trials_per_duration) +
(n_trials_150 < mixture_min_trials_per_duration) +
(n_trials_250 < mixture_min_trials_per_duration)
)
}
fit_exclusion_reason <- function(fit_status, low_trials, high_mean_alpha, high_max_alpha) {
reasons <- character()
if (!identical(fit_status, "ok")) {
reasons <- c(reasons, paste0("fit status: ", fit_status))
}
if (isTRUE(low_trials)) {
reasons <- c(reasons, "too few fit trials in at least one duration")
}
if (isTRUE(high_mean_alpha)) {
reasons <- c(reasons, paste0("mean alpha >= ", mixture_alpha_mean_threshold))
}
if (isTRUE(high_max_alpha)) {
reasons <- c(reasons, paste0("any alpha >= ", mixture_alpha_max_threshold))
}
if (length(reasons) == 0) "retain" else paste(reasons, collapse = "; ")
}
mixture_fit_report <- function(prepared_df, subset_key) {
pids <- sort(unique(prepared_df$participant_id))
out <- purrr::map(pids, function(pid) {
fit_mixture_one_participant(prepared_df, pid, subset_key)
})
fit_rows <- dplyr::bind_rows(purrr::compact(out))
fit_counts <- participant_fit_counts(prepared_df, subset_key)
fit_counts %>%
dplyr::left_join(fit_rows, by = c("subset", "participant_id")) %>%
dplyr::mutate(
fit_status = dplyr::coalesce(fit_status, "not_fit"),
alpha_mean = rowMeans(
dplyr::pick(alpha_ms50, alpha_ms150, alpha_ms250),
na.rm = TRUE
),
alpha_max = apply(
dplyr::pick(alpha_ms50, alpha_ms150, alpha_ms250),
1,
max,
na.rm = TRUE
),
alpha_mean = ifelse(is.nan(alpha_mean), NA_real_, alpha_mean),
alpha_max = ifelse(is.infinite(alpha_max), NA_real_, alpha_max),
exclude_fit_status = fit_status != "ok",
exclude_low_trials = n_duration_cells_below_min > 0,
exclude_high_mean_alpha = !is.na(alpha_mean) & alpha_mean >= mixture_alpha_mean_threshold,
exclude_high_max_alpha = !is.na(alpha_max) & alpha_max >= mixture_alpha_max_threshold,
recommended_exclude = exclude_fit_status |
exclude_low_trials |
exclude_high_mean_alpha |
exclude_high_max_alpha,
exclusion_reason = purrr::pmap_chr(
list(
fit_status,
exclude_low_trials,
exclude_high_mean_alpha,
exclude_high_max_alpha
),
fit_exclusion_reason
)
) %>%
dplyr::arrange(subset, participant_source, participant_code)
}
print_mixture_fit_report <- function(fit_report) {
cat(
"\nMixture-fit diagnostic model:\n",
"  set size =", mixture_set_size,
"| durations =", paste(mixture_duration_ms, collapse = "/"), "ms",
"| kappa =", mixture_kappa_fixed,
"| starts =", mixture_n_starts, "\n",
"Exclusion criteria:\n",
"  fit_status != ok OR any duration has <", mixture_min_trials_per_duration,
"fit trials OR mean alpha >=", mixture_alpha_mean_threshold,
"OR any alpha >=", mixture_alpha_max_threshold, "\n",
sep = " "
)
summary <- fit_report %>%
dplyr::group_by(subset, participant_source) %>%
dplyr::summarise(
participants = dplyr::n(),
recommended_exclusions = sum(recommended_exclude, na.rm = TRUE),
median_alpha_mean = round(stats::median(alpha_mean, na.rm = TRUE), 3),
max_alpha_mean = round(max(alpha_mean, na.rm = TRUE), 3),
.groups = "drop"
)
participant_exclusion_summary <- fit_report %>%
dplyr::mutate(
exclusion_tag = ifelse(recommended_exclude, "Exclude", "Retain"),
alpha_mean = round(alpha_mean, 3),
alpha_max = round(alpha_max, 3)
) %>%
dplyr::select(
subset,
participant_code,
participant_source,
participant_id,
exclusion_tag,
exclusion_reason,
n_trials_fit,
alpha_mean,
alpha_max,
fit_status
) %>%
dplyr::arrange(subset, participant_source, participant_code)
excluded_detail <- fit_report %>%
dplyr::filter(recommended_exclude) %>%
dplyr::select(
subset,
participant_code,
participant_source,
participant_id,
exclusion_tag = recommended_exclude,
exclusion_reason,
n_trials_fit,
n_trials_50,
n_trials_150,
n_trials_250,
alpha_ms50,
alpha_ms150,
alpha_ms250,
alpha_mean,
alpha_max,
fit_status
) %>%
dplyr::mutate(
exclusion_tag = ifelse(exclusion_tag, "Exclude", "Retain"),
dplyr::across(
dplyr::starts_with("alpha"),
~ round(.x, 3)
)
) %>%
dplyr::arrange(subset, participant_source, participant_code)
cat("\nMixture-fit participant summary:\n")
print(as.data.frame(summary), row.names = FALSE)
cat("\nParticipant-level exclusion table:\n")
if (requireNamespace("knitr", quietly = TRUE)) {
print(knitr::kable(as.data.frame(participant_exclusion_summary)))
} else {
print(as.data.frame(participant_exclusion_summary), row.names = FALSE)
}
if (show_detailed_alpha_diagnostics) {
cat("\nDetailed alpha diagnostics for excluded participants:\n")
if (nrow(excluded_detail) == 0) {
cat("None\n")
} else {
print(as.data.frame(excluded_detail), row.names = FALSE)
}
} else {
cat("\nDetailed alpha diagnostics are stored in mixture_fit_all; set show_detailed_alpha_diagnostics <- TRUE to print them.\n")
}
invisible(participant_exclusion_summary)
}
set.seed(42)
mixture_fit_sub1 <- mixture_fit_report(sub1prepared, "sub1")
mixture_fit_sub2 <- mixture_fit_report(sub2prepared, "sub2")
mixture_fit_sub3 <- mixture_fit_report(sub3prepared, "sub3")
mixture_fit_all <- dplyr::bind_rows(
mixture_fit_sub1,
mixture_fit_sub2,
mixture_fit_sub3
)
participant_exclusion_summary <- print_mixture_fit_report(mixture_fit_all)
participant_exclusion_mode <- "fit_recommendation" # options: "fit_recommendation", "manual", "none"
manual_exclusion_map <- list(
#sub1 = c("08", "18", "24", "25", "29", "30"),
sub1 = c("08", "14", "18", "21", "24", "25", "29","30","32"),
#sub2 = c("01", "10", "12", "22", "29", "30", "31"),
sub2 = c("01", "09", "10","12","15","17","18","22","23","24","26","27","28","29","30","31"),
#sub3 = c("14", "20", "21", "28", "31")
sub3 = c("01","14","20","21","23","24","25","26","27","28","29","30","31")
)
fit_exclusion_map <- mixture_fit_all %>%
dplyr::filter(recommended_exclude) %>%
dplyr::group_by(subset) %>%
dplyr::summarise(ids = list(participant_id), .groups = "drop") %>%
{ stats::setNames(.$ids, .$subset) }
empty_exclusion_map <- list(sub1 = character(), sub2 = character(), sub3 = character())
exclusion_map <- switch(
participant_exclusion_mode,
fit_recommendation = utils::modifyList(empty_exclusion_map, fit_exclusion_map),
manual = manual_exclusion_map,
none = empty_exclusion_map,
stop("participant_exclusion_mode must be 'fit_recommendation', 'manual', or 'none'")
)
sub1_analysis <- sub1prepared %>% filter(!participant_id %in% exclusion_map$sub1)
sub2_analysis <- sub2prepared %>% filter(!participant_id %in% exclusion_map$sub2)
sub3_analysis <- sub3prepared %>% filter(!participant_id %in% exclusion_map$sub3)
attr(sub1_analysis, "subset_key") <- "sub1"
attr(sub2_analysis, "subset_key") <- "sub2"
attr(sub3_analysis, "subset_key") <- "sub3"
cat("\nApplied participant exclusions using mode:", participant_exclusion_mode, "\n")
print(as.data.frame(tibble::tibble(
subset = names(exclusion_map),
excluded_participant_ids = vapply(exclusion_map, paste, collapse = ", ", FUN.VALUE = character(1)),
n_excluded = vapply(exclusion_map, length, FUN.VALUE = integer(1))
)), row.names = FALSE)
cat("Post-exclusion analysis row counts:",
"sub1_analysis =", nrow(sub1_analysis),
"sub2_analysis =", nrow(sub2_analysis),
"sub3_analysis =", nrow(sub3_analysis), "\n")
pd <- position_dodge(width = 0.6)
pj <- position_jitterdodge(dodge.width = 0.6, jitter.width = 0.15, seed = 42)
# Consistent across subexperiments: R / NR match sub1; Baseline distinct (sub2, sub3)
cue_type_colors <- c(
"R-cue" = "#E884A6",
"NR-cue" = "#3D9B9B",
"Baseline" = "#4CAF50"
)
add_cue_type_scales <- function(plot) {
plot +
ggplot2::scale_fill_manual(values = cue_type_colors) +
ggplot2::scale_color_manual(values = cue_type_colors)
}
summarise_cirsd_by_condition <- function(data, include_set_size = FALSE, axial = FALSE) {
group_vars <- c("duration_ms", "cue_type")
if (include_set_size) group_vars <- c(group_vars, "num_items")
# group_modify: explicit per-group theta vectors (avoids summarise + .data[[col]] quirks)
data %>%
dplyr::mutate(theta_axial_rad = 2 * theta_rad) %>%
dplyr::group_by(dplyr::across(dplyr::all_of(group_vars))) %>%
dplyr::group_modify(~ {
theta_vec <- if (axial) .x$theta_axial_rad else .x$theta_rad
circ <- circ_stats_safe(theta_vec, axial = FALSE)
if (axial) {
circ <- circ %>%
dplyr::mutate(
std_circ = std_circ / 2,
std_circ_deg = std_circ_deg / 2
)
}
circ
}) %>%
dplyr::ungroup()
}
plot_group_precision <- function(data, label, include_set_size = FALSE, axial = FALSE) {
summary <- summarise_cirsd_by_condition(
data,
include_set_size = include_set_size,
axial = axial
)
plot <- ggplot(data, aes(x = factor(duration_ms), y = abs_precision_deg, fill = cue_type, color = cue_type)) +
geom_boxplot(alpha = 0.5, position = pd, outlier.shape = NA) +
#geom_jitter(position = pj, alpha = 0.35, size = 0.9) +
geom_point(
data = summary,
inherit.aes = FALSE,
aes(x = factor(duration_ms), y = std_circ_deg, fill = "gray", color = cue_type, group = cue_type),
shape = 23,
size = 2.5,
stroke = 1.1,
position = pd
) +
labs(title = paste(label, "precision (abs error)"),
subtitle = if (axial) "Axial CirSD (deg) per condition" else "CirSD (deg) per condition",
x = "Encoding duration (ms)", y = "Absolute precision (deg)") +
scale_x_discrete(labels = function(x) paste0(x, " ms")) +
theme_minimal() +
theme(legend.position = "top")
plot <- add_cue_type_scales(plot)
if (include_set_size) {
plot <- plot + facet_wrap(~ num_items, labeller = ggplot2::label_both)
}
plot
}
plot_group_rt <- function(data, label, include_set_size = FALSE) {
plot <- ggplot(data, aes(x = factor(duration_ms), y = rt_ms, fill = cue_type, color = cue_type)) +
geom_boxplot(alpha = 0.5, position = pd, outlier.shape = NA) +
geom_jitter(position = pj, alpha = 0.4, size = 1) +
labs(title = paste(label, "RT distribution"),
subtitle = "Conditioned RT spread with quartiles from boxplots",
x = "Encoding duration (ms)", y = "Response time (ms)") +
scale_x_discrete(labels = function(x) paste0(x, " ms")) +
theme_minimal() +
theme(legend.position = "top")
plot <- add_cue_type_scales(plot)
if (include_set_size) {
plot <- plot + facet_wrap(~ num_items, labeller = ggplot2::label_both)
}
plot
}
# Per-participant circular SD within each condition (same theta / axial rules as summarise_cirsd_by_condition)
participant_circsd_by_condition <- function(data, include_set_size = FALSE, axial = FALSE) {
group_vars <- c("participant_id", "duration_ms", "cue_type")
if (include_set_size) group_vars <- c(group_vars, "num_items")
data %>%
dplyr::mutate(theta_axial_rad = 2 * theta_rad) %>%
dplyr::group_by(dplyr::across(dplyr::all_of(group_vars))) %>%
dplyr::group_modify(~ {
theta_vec <- if (axial) .x$theta_axial_rad else .x$theta_rad
circ <- circ_stats_safe(theta_vec, axial = FALSE)
deg <- circ$std_circ_deg[[1]]
if (axial) deg <- deg / 2
tibble::tibble(std_circ_deg = deg, n_trials = nrow(.x))
}) %>%
dplyr::ungroup()
}
# Mean and 95% CI of participant-level CirSDs (one-sample t interval on participants)
summarise_participant_circsd_ci <- function(part_df, include_set_size = FALSE) {
group_vars <- c("duration_ms", "cue_type")
if (include_set_size) group_vars <- c(group_vars, "num_items")
part_df %>%
dplyr::group_by(dplyr::across(dplyr::all_of(group_vars))) %>%
dplyr::reframe({
x <- std_circ_deg[is.finite(std_circ_deg)]
n <- length(x)
if (n == 0L) {
tibble::tibble(
n_participants = 0L,
mean_circsd = NA_real_,
ci_low = NA_real_,
ci_high = NA_real_
)
} else if (n == 1L) {
tibble::tibble(
n_participants = 1L,
mean_circsd = x[1],
ci_low = x[1],
ci_high = x[1]
)
} else {
tt <- stats::t.test(x)
tibble::tibble(
n_participants = n,
mean_circsd = mean(x),
ci_low = tt$conf.int[1],
ci_high = tt$conf.int[2]
)
}
}) %>%
dplyr::ungroup()
}
pj_circsd <- position_jitterdodge(dodge.width = 0.6, jitter.width = 0.15, seed = 42)
plot_group_precision_participant_circsd <- function(data, label, include_set_size = FALSE, axial = FALSE) {
pdat <- participant_circsd_by_condition(data, include_set_size, axial)
sdat <- summarise_participant_circsd_ci(pdat, include_set_size)
plot <- ggplot2::ggplot() +
ggplot2::geom_point(
data = pdat,
ggplot2::aes(
x = factor(duration_ms),
y = std_circ_deg,
color = cue_type
),
position = pj_circsd,
alpha = 0.4,
size = 1.1
) +
ggplot2::geom_pointrange(
data = sdat,
ggplot2::aes(
x = factor(duration_ms),
y = mean_circsd,
ymin = ci_low,
ymax = ci_high,
color = cue_type
),
position = pd,
size = 0.25,
linewidth = 0.9
) +
ggplot2::labs(
title = paste(label, "precision - participant CirSD"),
subtitle = if (axial) {
"Per-participant axial CirSD (jitter); mean and 95% CI across participants"
} else {
"Per-participant CirSD (jitter); mean and 95% CI across participants"
},
x = "Encoding duration (ms)",
y = "Circular SD (deg)"
) +
ggplot2::scale_x_discrete(labels = function(x) paste0(x, " ms")) +
ggplot2::theme_minimal() +
ggplot2::theme(legend.position = "top")
plot <- plot + ggplot2::scale_color_manual(values = cue_type_colors)
if (include_set_size) {
plot <- plot + ggplot2::facet_wrap(~ num_items, labeller = ggplot2::label_both)
}
plot
}
plot_participant_condition_precision <- function(data, label, pid, include_set_size = FALSE, axial = FALSE) {
d <- data %>% filter(participant_id == pid)
if (nrow(d) == 0) return(NULL)
plot_group_precision(d, paste0(label, " — ", pid), include_set_size = include_set_size, axial = axial)
}
plot_participant_condition_rt <- function(data, label, pid, include_set_size = FALSE) {
d <- data %>% filter(participant_id == pid)
if (nrow(d) == 0) return(NULL)
plot_group_rt(d, paste0(label, " — ", pid), include_set_size = include_set_size)
}
walk_participant_condition_plots <- function(data, label, include_set_size, axial) {
pids <- sort(unique(data$participant_id))
purrr::walk(pids, function(pid) {
p_prec <- plot_participant_condition_precision(data, label, pid, include_set_size, axial)
if (!is.null(p_prec)) print(p_prec)
p_rt <- plot_participant_condition_rt(data, label, pid, include_set_size)
if (!is.null(p_rt)) print(p_rt)
})
}
print(plot_group_precision(sub1_analysis, "Practice Effect", include_set_size = FALSE, axial = FALSE))
print(plot_group_rt(sub1_analysis, "Practice Effect", include_set_size = FALSE))
