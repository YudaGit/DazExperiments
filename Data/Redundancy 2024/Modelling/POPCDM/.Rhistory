# Re-source the helper so plotting uses the latest axis-handling code even if
# the fitting chunks were run earlier in the same R session.
source(helper_file)
for (plot_uid in uids_to_fit) {
cat("\n\n### Error Marginals: ", plot_uid, "\n\n", sep = "")
plot_df <- prepare_redundancy_fit_frame(
data_csv,
uid_filter = plot_uid,
drop_na_cond = TRUE
)
plot_redundancy_error_marginals(
plot_df,
P_hats[[plot_uid]],
nw = grid$nw,
h = grid$h,
tmax = grid$tmax,
n_bins = 30L
)
}
