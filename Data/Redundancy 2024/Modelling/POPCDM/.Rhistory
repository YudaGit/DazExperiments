source("fit_popcdm_redundancy.R")
load_popcdm_sources()
data_csv <- "data2_final.csv"
if (!file.exists(data_csv)) {
stop("Cannot find ", data_csv, " — set working directory to Data/Redundancy 2024")
}
uids <- sort(unique(utils::read.csv(data_csv, stringsAsFactors = FALSE)$uid))
uids
P_var_start <- c(
alphaEst = 0.8,
vnorm_R = 2.5,
vnorm_NR = 2.2,
beta1 = 0.5,
beta2 = 0.5
)
lower <- c(0.05, 0.3, 0.3, 0.1, 0.1)
upper <- c(8.0, 8.0, 8.0, 0.9, 0.9)
fit_control <- list(maxit = 500L, factr = 1e7)
nw <- 50L
h <- 2.5 / 300
tmax <- 4.5
fits <- vector("list", length(uids))
names(fits) <- uids
for (uid in uids) {
message("Fitting participant: ", uid)
fit_df <- prepare_redundancy_fit_frame(data_csv, uid_filter = uid, drop_na_cond = TRUE)
fits[[uid]] <- fit_redundancy_popcdm_participant(
fit_df,
P_var_start = P_var_start,
lower = lower,
upper = upper,
nw = nw,
h = h,
tmax = tmax,
control = fit_control
)
}
nms <- c("alphaEst", "vnorm_R", "vnorm_NR", "beta1", "beta2")
fit_summary <- do.call(
rbind,
lapply(uids, function(u) {
f <- fits[[u]]
pv <- unname(as.numeric(f$P_var_hat))
if (length(pv) != length(nms)) {
stop("Unexpected P_var length for ", u)
}
names(pv) <- nms
eps <- 1e-5
il <- which(abs(pv - lower) < eps)
iu <- which(abs(upper - pv) < eps)
on_lower <- if (length(il)) paste(nms[il], collapse = ",") else NA_character_
on_upper <- if (length(iu)) paste(nms[iu], collapse = ",") else NA_character_
data.frame(
uid = u,
n_trials = f$n_trials,
nll = f$nll,
convergence = f$optim$convergence,
alphaEst = pv["alphaEst"],
vnorm_R = pv["vnorm_R"],
vnorm_NR = pv["vnorm_NR"],
beta1 = pv["beta1"],
beta2 = pv["beta2"],
at_lower = on_lower,
at_upper = on_upper,
stringsAsFactors = FALSE
)
})
)
rownames(fit_summary) <- NULL
fit_summary
P_var_start <- c(
alphaEst = 0.8,
vnorm_R = 2.5,
vnorm_NR = 2.2,
beta1 = 0.5,
beta2 = 0.5,
kappa = 1
)
lower <- c(0.01, 0.1, 0.1, 0.01, 0.01, 0.1)
upper <- c(10.0, 10.0, 10.0, 0.99, 0.99, 20)
fit_control <- list(maxit = 500L, factr = 1e7)
nw <- 50L
h <- 2.5 / 300
tmax <- 2.5
# Fixed tail of P (eta1, eta2, a, ter, st); kappa is free. Uncomment ONE:
P_fix <- redundancy_default_pfix()
# P_fix <- redundancy_pfix_alternative()   # softer eta2; still estimates kappa
source("fit_popcdm_redundancy.R")
load_popcdm_sources()
data_csv <- "data2_final.csv"
if (!file.exists(data_csv)) {
stop("Cannot find ", data_csv, " — set working directory to Data/Redundancy 2024")
}
uids <- sort(unique(utils::read.csv(data_csv, stringsAsFactors = FALSE)$uid))
uids
P_var_start <- c(
alphaEst = 0.8,
vnorm_R = 2.5,
vnorm_NR = 2.2,
beta1 = 0.5,
beta2 = 0.5,
kappa = 1
)
lower <- c(0.01, 0.1, 0.1, 0.01, 0.01, 0.1)
upper <- c(10.0, 10.0, 10.0, 0.99, 0.99, 20)
fit_control <- list(maxit = 500L, factr = 1e7)
nw <- 50L
h <- 2.5 / 300
tmax <- 2.5
# Fixed tail of P (eta1, eta2, a, ter, st); kappa is free. Uncomment ONE:
P_fix <- redundancy_default_pfix()
# P_fix <- redundancy_pfix_alternative()   # softer eta2; still estimates kappa
fits <- vector("list", length(uids))
names(fits) <- uids
for (uid in uids) {
message("Fitting participant: ", uid)
fit_df <- prepare_redundancy_fit_frame(data_csv, uid_filter = uid, drop_na_cond = TRUE)
fits[[uid]] <- fit_redundancy_popcdm_participant(
fit_df,
P_var_start = P_var_start,
lower = lower,
upper = upper,
P_fix = P_fix,
nw = nw,
h = h,
tmax = tmax,
control = fit_control
)
}
nms <- c("alphaEst", "vnorm_R", "vnorm_NR", "beta1", "beta2", "kappa")
fit_summary <- do.call(
rbind,
lapply(uids, function(u) {
f <- fits[[u]]
pv <- unname(as.numeric(f$P_var_hat))
if (length(pv) != length(nms)) {
stop("Unexpected P_var length for ", u)
}
names(pv) <- nms
eps <- 1e-5
il <- which(abs(pv - lower) < eps)
iu <- which(abs(upper - pv) < eps)
on_lower <- if (length(il)) paste(nms[il], collapse = ",") else NA_character_
on_upper <- if (length(iu)) paste(nms[iu], collapse = ",") else NA_character_
data.frame(
uid = u,
n_trials = f$n_trials,
nll = f$nll,
np_free = f$np_free,
convergence = f$optim$convergence,
alphaEst = pv["alphaEst"],
vnorm_R = pv["vnorm_R"],
vnorm_NR = pv["vnorm_NR"],
beta1 = pv["beta1"],
beta2 = pv["beta2"],
kappa = pv["kappa"],
at_lower = on_lower,
at_upper = on_upper,
stringsAsFactors = FALSE
)
})
)
rownames(fit_summary) <- NULL
fit_summary
