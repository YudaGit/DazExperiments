source("fit_popcdm_redundancy.R")
load_popcdm_sources()
data_csv <- "data2_final.csv"
if (!file.exists(data_csv)) {
stop("Cannot find ", data_csv, " — set working directory to Data/Redundancy 2024")
}
uids <- sort(unique(utils::read.csv(data_csv, stringsAsFactors = FALSE)$uid))
uids
P_var_start <- c(
alphaEst = 0.8,
vnorm_R = 2.5,
vnorm_NR = 2.2,
beta1 = 0.45,
beta2 = 0.45
)
lower <- c(0.05, 0.3, 0.3, 0.05, 0.05)
upper <- c(5.0, 8.0, 8.0, 1.5, 1.5)
fit_control <- list(maxit = 500L, factr = 1e7)
nw <- 50L
h <- 2.5 / 300
tmax <- 2.5
fits <- vector("list", length(uids))
names(fits) <- uids
for (uid in uids) {
message("Fitting participant: ", uid)
fit_df <- prepare_redundancy_fit_frame(data_csv, uid_filter = uid, drop_na_cond = TRUE)
fits[[uid]] <- fit_redundancy_popcdm_participant(
fit_df,
P_var_start = P_var_start,
lower = lower,
upper = upper,
nw = nw,
h = h,
tmax = tmax,
control = fit_control
)
}
fit_summary <- do.call(
rbind,
lapply(uids, function(u) {
f <- fits[[u]]
pv <- as.numeric(f$P_var_hat)
data.frame(
uid = u,
n_trials = f$n_trials,
nll = f$nll,
convergence = f$optim$convergence,
alphaEst = pv[1],
vnorm_R = pv[2],
vnorm_NR = pv[3],
beta1 = pv[4],
beta2 = pv[5],
stringsAsFactors = FALSE
)
})
)
rownames(fit_summary) <- NULL
fit_summary
fits[["YL"]]$P_full_hat
fits[["YL"]]$optim
