n_cores <- min(parallel_settings$n_cores, length(uids_to_fit))
message("Fitting ", length(uids_to_fit), " participants using ", n_cores, " cores.")
fits <- parallel::mclapply(
uids_to_fit,
fit_one_participant,
mc.cores = n_cores,
mc.set.seed = TRUE
)
names(fits) <- uids_to_fit
} else {
fits <- lapply(uids_to_fit, fit_one_participant)
names(fits) <- uids_to_fit
}
rm(list = ls())
data_csv <- "data2_final.csv"
helper_file <- "fit_popcdm_redundancy.R"
# POPCDM source folder. Use "." if besselFPT.R, popcode.R, and popcdm300.R
# are copied into this folder. The current fallback points to the central copy.
POPCDM_R_DIR <- Sys.getenv(
"POPCDM_R_DIR",
"/Users/prefabteam_ysl/Documents/GitHub/DazExperiments/Models/CDM/POPCDM_R"
)
load_popcdm_sources <- function(dir = POPCDM_R_DIR) {
if (!dir.exists(dir)) {
stop("POPCDM_R_DIR not found: ", dir, call. = FALSE)
}
owd <- getwd()
on.exit(setwd(owd), add = TRUE)
setwd(dir)
source("popcode.R", local = FALSE)
source("besselFPT.R", local = FALSE)
source("popcdm300.R", local = FALSE)
}
if (!file.exists(data_csv)) {
stop("Cannot find ", data_csv, ". Set the working directory to the POPCDM folder.")
}
if (!file.exists(helper_file)) {
stop("Cannot find ", helper_file, ".")
}
source(helper_file)
load_popcdm_sources()
# Use NULL for all participants, or e.g. c("YL", "PG") for a subset.
participant_ids <- NULL
# Set trial_cap_per_condition <- NULL only after the pilot works.
trial_cap_per_condition <- 200L
random_seed <- 1L
# Coarse pilot grid. Increase nw / decrease h after the workflow is stable.
grid <- list(
nw = 50L,
h =3.5/200,
tmax = 3.5
)
# Very short optimizer settings for a pipeline check.
# Increase n_starts and maxit for real fitting.
optim_settings <- list(
n_starts = 1L,
beta_link = "logit",
beta_latent_limit = 15,
progress = TRUE,
progress_every = 5L,
control = list(maxit = 200L, factr = 1e7)
)
# Parallelise across participants. This is useful when participant_ids is NULL
# or contains more than one uid. On macOS this uses forked R processes.
parallel_settings <- list(
use_parallel = FALSE,
n_cores = min(parallel::detectCores(logical = FALSE), 5L, na.rm = TRUE)
)
# Full starting vector and broad bounds.
P_start <- redundancy_default_P(
alphaEst = 5.0,
vnorm = 2.5,
beta1 = 0.5,
beta2 = 0.5,
kappa = 5.0,
a = 2.0,
ter = 0.2,
eta1 = 1.0,
eta2 = 1e-6,
st = 0.2
)
bounds <- redundancy_default_bounds()
# Fully free condition-specific model: eta2 and st fixed, everything else free.
Sel <- redundancy_default_sel(free_eta2 = FALSE, free_st = FALSE)
ci2_conditions <- c(
"set2_baseline",
"set4_R_cue",
"set4_NR_cue",
"set6_R_cue_ci2",
"set6_NR_cue_ci2"
)
ci4_conditions <- c(
"set4_baseline",
"set6_R_cue_ci4",
"set6_NR_cue_ci4"
)
m_ci_vkt <- redundancy_model_spec(
label = "ci_group_vnorm_kappa_ter_one_a_one_eta1",
equal_groups = list(
# One shared a across all conditions.
redundancy_equal_group("a", COND_LEVELS),
# One shared eta1 across all conditions.
redundancy_equal_group("eta1", COND_LEVELS),
# vnorm grouped by ci.
redundancy_equal_group("vnorm", ci2_conditions),
redundancy_equal_group("vnorm", ci4_conditions),
# kappa grouped by ci.
redundancy_equal_group("kappa", ci2_conditions),
redundancy_equal_group("kappa", ci4_conditions),
# ter grouped by ci.
redundancy_equal_group("ter", ci2_conditions),
redundancy_equal_group("ter", ci4_conditions)
)
)
fit_inputs <- redundancy_fit_inputs(
P_start = P_start,
lower = bounds$lower,
upper = bounds$upper,
Sel = Sel,
model_spec = m_ci_vkt
)
length(P_start)
length(fit_inputs$P_var_start)
names(fit_inputs$P_fix)
stopifnot(length(fit_inputs$P_var_start) == 14L)
# Use NULL for all participants, or e.g. c("YL", "PG") for a subset.
participant_ids <- NULL
# Set trial_cap_per_condition <- NULL only after the pilot works.
