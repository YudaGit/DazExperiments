
save('jp_fit_freePsi_groupedVnorm_results.mat', ...
    'fitResultKappaCond', ...
    'allParticipantFits', ...
    'modelKappaCond', ...
    'condLevels', ...
    'targetIDs', ...
    'lb', 'ub', ...
    'stFixed', ...
    'tmax', ...
    'nStarts');

figs = findall(0, 'Type', 'figure');

for i = 1:numel(figs)
    savefig(figs(i), sprintf('jp_fit_fig_%02d.fig', i));
    exportgraphics(figs(i), sprintf('jp_fit_fig_%02d.png', i), 'Resolution', 300);
end