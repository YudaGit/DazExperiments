% =========================================================================
% Learning to fit the JPCDM 
%==========================================================================

clear; clc;
rng(1); % setting seed

% 1. Choose "true" parameters for simulation

% P = [vnorm, kappa, eta, psi, a, ter, st]
Pgen1 = [10.0, 2.0, 0.30, 0.10, 1.0, 0.20, 0.05];
Pgen2 = [10.0, 5.0, 0.30, 0.40, 1.0, 0.20, 0.05];

tmax = 3.0;
nTrials = 5000;

% 2. Generate Gt, Theta and T

[T1,Gt1, Theta1, Ptheta1, Mt1] = jpcdm1(Pgen1, tmax);
[T2,Gt2, Theta2, Ptheta2, Mt2] = jpcdm1(Pgen2, tmax);
% 3. Create prob mass grid

ThetaOpen1 = Theta1(1:end-1);
ThetaOpen2 = Theta2(1:end-1);
GtOpen1 = Gt1(1:end-1, :); % delete the wrap around row
GtOpen2 = Gt2(1:end-1, :);

dtheta1 = ThetaOpen1(2)-ThetaOpen1(1);
dtheta2 = ThetaOpen2(2)-ThetaOpen2(1);

dt1 = T1(2) - T1(1);
dt2 = T2(2) - T2(1);

cellProb1 = GtOpen1 * dt1 * dtheta1;
cellProb1 = cellProb1(:);
cellProb1 = max(cellProb1, 0);
cellProb1 = cellProb1 / sum(cellProb1);

cellProb2 = GtOpen2 * dt2 * dtheta2;
cellProb2 = cellProb2(:);
cellProb2 = max(cellProb2, 0);
cellProb2 = cellProb2 / sum(cellProb2);

% 4, sample Response angle and Rt from the joint density

cdf1 = cumsum(cellProb1);
cdf1(end) = 1;
unif1 = rand(nTrials, 1);

cdf2 = cumsum(cellProb2);
cdf2(end) = 1;
unif2 = rand(nTrials, 1);

sampledCell1 = arrayfun(@(x) find(cdf1 >= x, 1, "first"), unif1);

[angleIdx1, tIdx1] = ind2sub(size(GtOpen1), sampledCell1);

sampledCell2 = arrayfun(@(x) find(cdf2 >= x, 1, "first"), unif2);

[angleIdx2, tIdx2] = ind2sub(size(GtOpen2), sampledCell2);


angle1 = ThetaOpen1(angleIdx1)' + (rand(nTrials, 1)-0.5) * dtheta1; % draw angle using idx and add jitter
angle1 = mod(angle1+pi, 2*pi) - pi; % wrap around and prevent going outside the circle

angle2 = ThetaOpen2(angleIdx2)' + (rand(nTrials, 1)-0.5) * dtheta2; % draw angle using idx and add jitter
angle2 = mod(angle2+pi, 2*pi) - pi; % wrap around and prevent going outside the circle

rt1 = T1(tIdx1)' + (rand(nTrials, 1) - 0.5) * dt1;
rt1 = max(rt1, 0);

rt2 = T2(tIdx2)' + (rand(nTrials, 1) - 0.5) * dt2;
rt2 = max(rt2, 0);

simData1 = table(angle, rt, ...
    'VariableNames', {'rAngle', 'rt'});

simData1 = table(angle, rt, ...
    'VariableNames', {'rAngle', 'rt'});


% -------------------------------------------------------------------------
% 4. Quick checks and plots
% -------------------------------------------------------------------------
fprintf('Simulated %d trials from JPCDM.\n', nTrials);
fprintf('Generating P = [vnorm, kappa, eta, psi, a, ter, st]\n');
disp(Pgen);

figure;
tiledlayout(2, 2);

nexttile;
plot(Theta, Ptheta, 'LineWidth', 1.5);
xlabel('Response angle');
ylabel('Predicted P(\theta)');
title('Model response-angle distribution');

nexttile;
histogram(angle, 30, 'Normalization', 'pdf');
xlabel('Simulated response angle');
ylabel('Density');
title('Simulated response angles');

nexttile;
imagesc(T, ThetaOpen, GtOpen);
axis xy;
xlabel('RT');
ylabel('Response angle');
title('Model joint density Gt');
colorbar;

nexttile;
scatter(rt, angle, 8, 'filled', 'MarkerFaceAlpha', 0.25);
xlabel('RT');
ylabel('Response angle');
title('Simulated trials');

%=======================
% Fit Pgen simulated data for parameter recovery
%=======================

% P = [vnorm, kappa, eta, psi, a, ter, st]
lb = [0.01, 0.01, 0.02, -1.00, 0.20, 0.00, 0.00];
ub = [20.0, 20.0, 2.00,  1.00, 3.00, 1.00, 0.50];

nStarts = 20;

Pstarts = lb + rand(nStarts, length(lb)) .* (ub - lb);

% Diagnostic only: include one start near the generating parameters
Pstarts(1, :) = Pgen;

options = optimset('Display', 'off', 'MaxIter', 500, 'MaxFunEvals', 2000);

allPfit = zeros(nStarts, length(lb));
allNLL = zeros(nStarts, 1);

for s = 1:nStarts
    qstart = p_to_q(Pstarts(s, :), lb, ub);
    obj = @(q) jpcdm_nll(q_to_p(q, lb, ub), simData1, tmax);

    qfit = fminsearch(obj, qstart, options);

    allPfit(s, :) = q_to_p(qfit, lb, ub);
    allNLL(s) = jpcdm_nll(allPfit(s, :), simData1, tmax);
end

[bestNLL, bestIdx] = min(allNLL);
Pfit = allPfit(bestIdx, :);

fprintf('Generating P:\n');
disp(Pgen);

fprintf('Best fitted P:\n');
disp(Pfit);

fprintf('NLL at Pgen: %.4f\n', jpcdm_nll(Pgen, simData1, tmax));
fprintf('Best fitted NLL: %.4f\n', bestNLL);

[Tgen, Gtgen, Thetagen, Pthetag, Mtgen] = jpcdm1(Pgen, tmax);
[Tfit, Gtfit, Thetafit, Pthetaf, Mtfit] = jpcdm1(Pfit, tmax);

figure;
tiledlayout(1, 2);

nexttile;
plot(Thetagen, Pthetag, 'k-', 'LineWidth', 2); hold on;
plot(Thetafit, Pthetaf, 'r--', 'LineWidth', 2);
legend('Generating', 'Fitted');
xlabel('Response angle');
ylabel('Ptheta');
title('Response-angle distribution');

nexttile;
plot(Thetagen, Mtgen, 'k-', 'LineWidth', 2); hold on;
plot(Thetafit, Mtfit, 'r--', 'LineWidth', 2);
legend('Generating', 'Fitted');
xlabel('Response angle');
ylabel('Mean RT');
title('Mean RT by angle');

figure;
plot(Thetagen, (Mtfit - Mtgen) * 1000, 'LineWidth', 2);
xlabel('Response angle');
ylabel('Fitted - Generating Mean RT (ms)');
title('Mean RT Difference by Angle');
yline(0, 'k--');

ThetaOpen = Thetagen(1:end-1);
GtgenOpen = Gtgen(1:end-1, :);
GtfitOpen = Gtfit(1:end-1, :);

dtheta = ThetaOpen(2) - ThetaOpen(1);

rtGen = sum(GtgenOpen, 1) * dtheta;
rtFit = sum(GtfitOpen, 1) * dtheta;

figure;
plot(Tgen, rtGen, 'k-', 'LineWidth', 2); hold on;
plot(Tfit, rtFit, 'r--', 'LineWidth', 2);
legend('Generating', 'Fitted');
xlabel('RT');
ylabel('Density');
title('Marginal RT distribution');

%=======================
% Local helper functions
%=======================

function q = p_to_q(P, lb, ub)
    z = (P - lb) ./ (ub - lb);
    z = min(max(z, 1e-9), 1 - 1e-9);
    q = log(z ./ (1 - z));
end

function P = q_to_p(q, lb, ub)
    z = 1 ./ (1 + exp(-q));
    P = lb + (ub - lb) .* z;
end
