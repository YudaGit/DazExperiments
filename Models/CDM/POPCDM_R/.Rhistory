#install.packages("cmdstanr", repos = c("https://mc-stan.org/r-packages/", getOption("repos")))
#cmdstanr::install_cmdstan()
#options(brms.backend = "cmdstanr")
library(tidyverse)
library(brms)
library(bayesplot)
library(tidybayes)
library(emmeans)
library(patchwork)
library(loo)
theme_set(theme_bw())
options(mc.cores = parallel::detectCores())
set.seed(1234)
d <- read_csv("S1_smallN_model_ready.csv")
glimpse(d)
summary(d)
m2_sessionz <- brm(
AbsErr ~ CueType * DurationF * Session_z +
(1 + CueType | ID),
data = d,
family = student(),
prior = c(
prior(normal(40, 20), class = Intercept),
prior(normal(0, 10), class = b),
prior(exponential(1), class = sigma),
prior(exponential(1), class = sd)
),
chains = 4,
cores = 4,
iter = 4000,
warmup = 2000,
control = list(
adapt_delta = 0.99,
max_treedepth = 15
),
seed = 2346
)
d <- d %>%
mutate(
ID = factor(ID),
CueType = factor(CueType,
levels = c("NR", "R")),
DurationF = factor(Duration,
levels = c(
"50ms",
"100ms",
"150ms",
"200ms",
"250ms",
"300ms",
"350ms")),
Grouping = factor(Grouping),
SessionF = factor(Session),
SessionPhase = factor(
SessionPhase,
levels = c("Early", "Middle", "Late")
),
logRT = log(RT)
)
levels(d$DurationF)
levels(d$SessionF)
levels(d$CueType)
levels(d$Grouping)
d %>%
count(ID, CueType, DurationF)
d %>%
group_by(CueType, DurationF) %>%
summarise(
mean_signed = mean(SignedErr, na.rm = TRUE),
sd_signed = sd(SignedErr, na.rm = TRUE),
.groups = "drop"
)
m2_sessionz <- brm(
AbsErr ~ CueType * DurationF * Session_z +
(1 + CueType | ID),
data = d,
family = student(),
prior = c(
prior(normal(40, 20), class = Intercept),
prior(normal(0, 10), class = b),
prior(exponential(1), class = sigma),
prior(exponential(1), class = sd)
),
chains = 4,
cores = 4,
iter = 4000,
warmup = 2000,
control = list(
adapt_delta = 0.99,
max_treedepth = 15
),
seed = 2346
)
saveRDS(m2_sessionz, "m2_sessionz_cue_duration_learning.rds")
m2_sessionz <- readRDS("m2_sessionz_cue_duration_learning.rds")
summary(m2_sessionz)
emm_m2 <- emmeans(
m2_sessionz,
~ CueType * DurationF,
at = list(Session_z = 0)
)
emm_m2
confint(emm_m2)
gain_m2 <- contrast(
emm_m2,
method = list("NR - R" = c(1, -1)),
by = "DurationF"
)
gain_m2
confint(gain_m2)
gain_m2_df <- as.data.frame(confint(gain_m2))
names(gain_m2_df)
ggplot(gain_m2_df, aes(x = DurationF, y = estimate)) +
geom_line(aes(group = 1), linewidth = 1) +
geom_point(size = 3) +
geom_errorbar(
aes(ymin = lower.HPD, ymax = upper.HPD),
width = .15
) +
labs(
x = "Exposure Duration",
y = "Estimated Redundancy Gain (NR - R)",
title = "Posterior Redundancy Gain at Average Session"
) +
theme_bw()
session_grid <- expand.grid(
Session_z = seq(min(d$Session_z), max(d$Session_z), length.out = 100),
CueType = levels(d$CueType),
DurationF = levels(d$DurationF)
)
pred_session <- fitted(
m2_sessionz,
newdata = session_grid,
re_formula = NA,
summary = TRUE
)
session_pred_df <- bind_cols(
session_grid,
as.data.frame(pred_session)
)
ggplot(
session_pred_df,
aes(x = Session_z, y = Estimate, colour = CueType)
) +
geom_line(linewidth = 1) +
geom_ribbon(
aes(ymin = Q2.5, ymax = Q97.5, fill = CueType),
alpha = .15,
colour = NA
) +
facet_wrap(~DurationF) +
labs(
x = "Session progression (z-scored)",
y = "Predicted Absolute Error (deg)",
title = "Predicted Session Learning by Cue and Duration"
) +
theme_bw()
session_grid_avg <- expand.grid(
Session_z = seq(min(d$Session_z), max(d$Session_z), length.out = 100),
CueType = levels(d$CueType),
DurationF = levels(d$DurationF)
)
pred_session_avg <- fitted(
m2_sessionz,
newdata = session_grid_avg,
re_formula = NA,
summary = TRUE
)
session_avg_df <- bind_cols(
session_grid_avg,
as.data.frame(pred_session_avg)
) %>%
group_by(Session_z, CueType) %>%
summarise(
Estimate = mean(Estimate),
Q2.5 = mean(Q2.5),
Q97.5 = mean(Q97.5),
.groups = "drop"
)
ggplot(
session_avg_df,
aes(x = Session_z, y = Estimate, colour = CueType)
) +
geom_line(linewidth = 1.2) +
geom_ribbon(
aes(ymin = Q2.5, ymax = Q97.5, fill = CueType),
alpha = .15,
colour = NA
) +
labs(
x = "Session progression (z-scored)",
y = "Predicted Absolute Error (deg)",
title = "Predicted Session Learning Averaged Across Durations"
) +
theme_bw()
loo_m1_sum <- loo(m1_sum, moment_match = TRUE)
m1_sum <- readRDS("m1_sum.rds")
summary(m1_sum)
#save.image("S1_analysis_workspace.RData")
loo_m1_sum <- loo(m1_sum)
loo_m2_sessionz <- loo(m2_sessionz)
loo_compare(loo_m1_sum, loo_m2_sessionz)
