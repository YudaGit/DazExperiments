library(tidyverse)
library(brms)
library(bayesplot)
library(tidybayes)
library(emmeans)
library(patchwork)
library(loo)
theme_set(theme_bw())
options(mc.cores = parallel::detectCores())
set.seed(1234)
m2_sessionz <- brm(
AbsErr ~ CueType * DurationF * Session_z +
(1 + CueType | ID),
data = d,
family = student(),
prior = c(
prior(normal(40, 20), class = Intercept),
prior(normal(0, 10), class = b),
prior(exponential(1), class = sigma),
prior(exponential(1), class = sd)
),
chains = 4,
cores = 4,
iter = 4000,
warmup = 2000,
control = list(
adapt_delta = 0.99,
max_treedepth = 15
),
seed = 2346
)
